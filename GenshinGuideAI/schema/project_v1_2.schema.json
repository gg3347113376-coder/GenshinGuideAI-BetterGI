{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genshin-guide-ai.local/schema/project_v1_1.schema.json",
  "title": "GenshinGuideAI Project 1.2 - offline evidence grounding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "sources",
    "segments",
    "events",
    "evidence_index",
    "analysis_runs",
    "task_plan",
    "simulation_runs",
    "execution_runs",
    "grounding"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string"
        },
        "model_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "OCR/ASR/VLM/规则版本，用于追溯"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "evidence_index": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "kind": {
            "enum": [
              "frame",
              "asr"
            ]
          },
          "time": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start_s",
              "end_s"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string"
          },
          "method": {
            "enum": [
              "video_decode",
              "existing_asr"
            ]
          }
        },
        "required": [
          "id",
          "source_id",
          "kind",
          "time",
          "path",
          "sha256",
          "text",
          "method"
        ]
      },
      "minItems": 1
    },
    "analysis_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "stage": {
            "enum": [
              "visual_observation",
              "task_understanding"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "model_digest": {
            "type": "string",
            "minLength": 1
          },
          "request_path": {
            "type": "string",
            "minLength": 1
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "response_path": {
            "type": "string",
            "minLength": 1
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "elapsed_s": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "const": "parsed"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "stage",
          "model",
          "model_digest",
          "request_path",
          "request_sha256",
          "response_path",
          "response_sha256",
          "elapsed_s",
          "status",
          "evidence_ids"
        ]
      },
      "minItems": 1
    },
    "task_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "catalog_version": {
          "const": "1.0.0"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "plan_only"
        },
        "execution_allowed": {
          "const": false
        },
        "status": {
          "const": "needs_review"
        },
        "analysis_run_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "action_id": {
                "enum": [
                  "teleport",
                  "move_to",
                  "sprint",
                  "climb",
                  "interact",
                  "dialogue_choice",
                  "fight",
                  "wait",
                  "unknown"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "params": {
                "type": "object"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "uniqueItems": true
              },
              "source_event_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "enum": [
                        "input.focused",
                        "frame.fresh",
                        "ui.main",
                        "waypoint.unlocked",
                        "position.arrived",
                        "route.valid",
                        "stamina.enough",
                        "climb.reachable",
                        "target.unique",
                        "interaction.changed",
                        "dialogue.option_unique",
                        "dialogue.advanced",
                        "combat.configured",
                        "combat.finished",
                        "wait.condition",
                        "unsupported"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "const": "not_checked"
                    }
                  },
                  "required": [
                    "id",
                    "description",
                    "status"
                  ]
                },
                "minItems": 1
              },
              "expected_result": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "enum": [
                            "input.focused",
                            "frame.fresh",
                            "ui.main",
                            "waypoint.unlocked",
                            "position.arrived",
                            "route.valid",
                            "stamina.enough",
                            "climb.reachable",
                            "target.unique",
                            "interaction.changed",
                            "dialogue.option_unique",
                            "dialogue.advanced",
                            "combat.configured",
                            "combat.finished",
                            "wait.condition",
                            "unsupported"
                          ]
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1
                        },
                        "status": {
                          "const": "not_checked"
                        }
                      },
                      "required": [
                        "id",
                        "description",
                        "status"
                      ]
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "text",
                  "checks"
                ]
              },
              "observed_result": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "const": "not_executed"
                  },
                  "evidence_ids": {
                    "const": []
                  }
                },
                "required": [
                  "status",
                  "evidence_ids"
                ]
              },
              "status": {
                "enum": [
                  "blocked",
                  "needs_review"
                ]
              },
              "blockers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "detail"
                  ]
                }
              },
              "uncertainties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "timeout_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_retries": {
                "const": 0
              },
              "review": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "const": "pending"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "id",
              "action_id",
              "title",
              "intent",
              "params",
              "depends_on",
              "source_event_ids",
              "evidence_ids",
              "preconditions",
              "expected_result",
              "observed_result",
              "status",
              "blockers",
              "uncertainties",
              "confidence",
              "timeout_s",
              "max_retries",
              "review"
            ]
          },
          "minItems": 1
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "catalog_version",
        "goal",
        "mode",
        "execution_allowed",
        "status",
        "analysis_run_ids",
        "steps",
        "uncertainties",
        "confidence_note"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "simulation_runs": {
      "const": []
    },
    "execution_runs": {
      "const": []
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "ocr_artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "catalog_artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "retry_artifact": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "scene": {
                "enum": [
                  "map",
                  "gameplay_or_unknown",
                  "unknown"
                ]
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "bbox": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "role": {
                      "enum": [
                        "map_region",
                        "selected_anchor",
                        "selected_region",
                        "quest_tracker",
                        "interaction_prompt",
                        "subtitle",
                        "tutorial",
                        "unclassified",
                        "uncertain",
                        "persistent_ui",
                        "hud_or_overlay",
                        "editor_overlay",
                        "map_context"
                      ]
                    },
                    "eligible": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "confidence",
                    "bbox",
                    "role",
                    "eligible",
                    "reason"
                  ]
                }
              }
            },
            "required": [
              "evidence_id",
              "scene",
              "rows"
            ]
          }
        },
        "transcripts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "original": {
                "type": "string"
              },
              "alternative": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "not_retranscribed",
                  "agrees",
                  "alternative_unverified",
                  "context_only"
                ]
              },
              "proposed_terms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "corroborated_terms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "term": {
                      "type": "string",
                      "minLength": 1
                    },
                    "frame_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "term",
                    "frame_id",
                    "text_id"
                  ]
                }
              },
              "lexical_candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "original_fragment": {
                      "type": "string",
                      "minLength": 1
                    },
                    "candidate": {
                      "type": "string",
                      "minLength": 1
                    },
                    "frame_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "const": "proposed_not_replaced"
                    }
                  },
                  "required": [
                    "original_fragment",
                    "candidate",
                    "frame_id",
                    "text_id",
                    "status"
                  ]
                }
              }
            },
            "required": [
              "evidence_id",
              "original",
              "alternative",
              "status",
              "proposed_terms",
              "corroborated_terms",
              "lexical_candidates"
            ]
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "frame_id": {
                "type": "string",
                "minLength": 1
              },
              "anchor_type": {
                "enum": [
                  "TeleportWaypoint",
                  "Goddess",
                  "Domain",
                  "unknown"
                ]
              },
              "identity_status": {
                "enum": [
                  "not_identified",
                  "type_only",
                  "ambiguous_type",
                  "candidate_unique",
                  "ambiguous_candidates"
                ]
              },
              "selected_panel_visible": {
                "type": "boolean"
              },
              "text_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "region_text_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "region_labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scene_id": {
                      "type": "integer"
                    },
                    "id": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "areas": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "scene_id",
                    "id",
                    "name",
                    "type",
                    "areas"
                  ]
                }
              },
              "verified_point_id": {
                "type": "null"
              },
              "verified_coordinates": {
                "type": "null"
              },
              "current_player_unlocked": {
                "const": "unknown"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "frame_id",
              "anchor_type",
              "identity_status",
              "selected_panel_visible",
              "text_ids",
              "region_text_ids",
              "region_labels",
              "candidates",
              "verified_point_id",
              "verified_coordinates",
              "current_player_unlocked",
              "note"
            ]
          }
        },
        "plan_review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "rejected",
                "pending_human_review"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "step_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "step_id",
                  "code",
                  "detail"
                ]
              }
            },
            "execution_allowed": {
              "const": false
            }
          },
          "required": [
            "status",
            "issues",
            "execution_allowed"
          ]
        }
      },
      "required": [
        "version",
        "ocr_artifact",
        "catalog_artifact",
        "retry_artifact",
        "frames",
        "transcripts",
        "anchors",
        "plan_review"
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "duration_s"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "fps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "start_s",
        "end_s",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "source_id": {
          "type": "string"
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "travel",
            "combat",
            "interaction",
            "dialogue",
            "cutscene",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "order",
        "video_time",
        "action",
        "state_status",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "source_id": {
          "type": "string"
        },
        "segment_id": {
          "type": [
            "string",
            "null"
          ]
        },
