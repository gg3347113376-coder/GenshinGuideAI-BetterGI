  "actions": [
    {
      "id": "teleport",
      "name": "锚点传送",
      "legacy_event_type": "teleport",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_label": {
            "type": "string",
            "minLength": 1
          },
          "map_x": {
            "type": [
              "number",
              "null"
            ]
          },
          "map_y": {
            "type": [
              "number",
              "null"
            ]
          },
          "layer": {
            "enum": [
              "surface",
              "underground",
              "cave",
              "interior",
              "instance",
              "unknown"
            ]
          },
          "coordinate_system": {
            "enum": [
              "BetterGI_Teyvat",
              "unknown"
            ]
          }
        },
        "required": [
          "target_label",
          "map_x",
          "map_y",
          "layer",
          "coordinate_system"
        ]
      },
      "required_for_execution": [
        "map_x",
        "map_y",
        "layer",
        "coordinate_system"
      ],
      "preconditions": [
        "input.focused",
        "frame.fresh",
        "ui.main",
        "waypoint.unlocked"
      ],
      "postconditions": [
        "position.arrived"
      ],
      "timeout_s": 60,
      "max_retries": 0,
      "failure_policy": "stop_and_require_fresh_observation",
      "binding": {
        "path": "GuideWorkbench/natlan_live_runner.js",
        "symbol": "genshin.tp",
        "status": "source_present",
        "adapter_status": "not_connected",
        "live_validation": "not_verified_in_phase1"
      },
      "limitations": "第一阶段仅生成与校验计划，未接执行器"
