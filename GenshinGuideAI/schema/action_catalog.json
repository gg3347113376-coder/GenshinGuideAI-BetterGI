    "frame.fresh": "画面未断流，几何与窗口绑定未失效",
    "ui.main": "处于可操作主界面",
    "waypoint.unlocked": "目标锚点已解锁且坐标、地图层已核对",
    "position.arrived": "新定位在指定目标半径内，地图层一致",
    "route.valid": "路线存在，起点相符，当前地图层与路线一致",
    "stamina.enough": "体力满足该段预算",
